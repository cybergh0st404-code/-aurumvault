# ==============================================================================
# AurumVault — Git Ignore Rules
# ==============================================================================

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# Local SQLite Database & WAL / SHM Journals
data/*.db*
data/*.sqlite*
*.db
*.db-wal
*.db-shm
*.sqlite

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
.next/
out/
build/
dist/

# Vercel & Sandbox internal files
.vercel/
.snowflake/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# System & OS Files
.DS_Store
Thumbs.db
*.pem
*.key

# Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?